# AI-Remotion production placeholder.
# Keep keys in sync with config/.env.dev.example.
NODE_ENV=production

# AI-Remotion runtime provider config.
AI_REMOTION_ENV_FILE=
AI_REMOTION_LLM_PROVIDER=deterministic
AI_REMOTION_LLM_BASE_URL=
AI_REMOTION_LLM_API_KEY=
AI_REMOTION_LLM_MODEL=
AI_REMOTION_LLM_TEMPERATURE=0.4
AI_REMOTION_LLM_TIMEOUT_MS=60000
AI_REMOTION_LLM_FALLBACK_TO_DETERMINISTIC=true
AI_REMOTION_TTS_PROVIDER=silent
AI_REMOTION_TTS_BASE_URL=
AI_REMOTION_TTS_API_KEY=
AI_REMOTION_TTS_MODEL=
AI_REMOTION_TTS_VOICE=
AI_REMOTION_TTS_TIMEOUT_MS=60000
AI_REMOTION_AVATAR_PROVIDER=none
AI_REMOTION_AVATAR_BASE_URL=
AI_REMOTION_AVATAR_TIMEOUT_MS=300000
AI_REMOTION_HEYGEN_BASE_URL=https://api.heygen.com
AI_REMOTION_HEYGEN_POLL_INTERVAL_MS=5000
# Configure HEYGEN_API_KEY only in a local uncommitted env file.
AI_REMOTION_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_REMOTION_ARK_API_KEY=
AI_REMOTION_ARK_MODEL=
AI_REMOTION_TOS_ACCESS_KEY_ID=
AI_REMOTION_TOS_ACCESS_KEY_SECRET=
AI_REMOTION_TOS_SESSION_TOKEN=
AI_REMOTION_TOS_BUCKET=
AI_REMOTION_TOS_ENDPOINT=
AI_REMOTION_TOS_REGION=
AI_REMOTION_TOS_PREFIX=ai-remotion

# Digital-human features are fail-safe disabled. Enable only for explicitly
# consented voice and portrait assets in an internal environment.
FLAG_voice_clone={"enabled":false}
FLAG_talking_avatar={"enabled":false}
FLAG_avatar_motion={"enabled":false}
FLAG_generative_broll={"enabled":false}
FLAG_seedance_presenter={"enabled":false}
FLAG_latentsync_lipsync={"enabled":false}
FLAG_infinitetalk_avatar={"enabled":false}
FLAG_longcat_avatar={"enabled":false}
FLAG_heygen_avatar={"enabled":false}

# Optional DeepSeek configuration. Keep the fallback enabled to preserve
# deterministic script generation when the provider is unavailable.
# AI_REMOTION_LLM_PROVIDER=openai-compatible
# AI_REMOTION_LLM_BASE_URL=https://api.deepseek.com
# AI_REMOTION_LLM_API_KEY=
# AI_REMOTION_LLM_MODEL=deepseek-v4-flash

# Optional local CosyVoice FastAPI configuration. Start CosyVoice separately;
# its /inference_sft endpoint must return a WAV file.
# AI_REMOTION_TTS_PROVIDER=cosyvoice
# AI_REMOTION_TTS_BASE_URL=http://127.0.0.1:50000
# AI_REMOTION_TTS_VOICE=<CosyVoice speaker ID>
# AI_REMOTION_TTS_PROVIDER=cosyvoice-clone
# AI_REMOTION_AVATAR_PROVIDER=musetalk
# AI_REMOTION_AVATAR_BASE_URL=http://127.0.0.1:8001
# AI_REMOTION_AVATAR_PROVIDER=seedance
# AI_REMOTION_ARK_MODEL=doubao-seedance-2-0-260128
# AI_REMOTION_AVATAR_PROVIDER=latentsync
# AI_REMOTION_AVATAR_BASE_URL=http://127.0.0.1:8004
# AI_REMOTION_AVATAR_PROVIDER=infinitetalk
# AI_REMOTION_AVATAR_BASE_URL=http://127.0.0.1:8005
# AI_REMOTION_AVATAR_PROVIDER=longcat
# AI_REMOTION_AVATAR_BASE_URL=http://127.0.0.1:8006
# AI_REMOTION_AVATAR_PROVIDER=heygen
# HEYGEN_API_KEY=

# Harness placeholders.
TTS_PROVIDER=none
LLM_PROVIDER=mock
OBSERVABILITY_BACKEND=mock
TRACKER=github-dryrun
