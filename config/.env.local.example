# Local overlay for this machine. Copy to repo-root `.env.local` and fill secrets.
# `.env.local` is gitignored. Commit this example only — never real keys.
#
#   cp config/.env.local.example .env.local
#
# Flags stay false here. Turn them on in `.env.local` for an approved internal run.

AI_REMOTION_LLM_PROVIDER=openai-compatible
AI_REMOTION_LLM_BASE_URL=https://api.deepseek.com
AI_REMOTION_LLM_API_KEY=
AI_REMOTION_LLM_MODEL=deepseek-v4-flash

AI_REMOTION_TTS_PROVIDER=cosyvoice-clone
AI_REMOTION_TTS_BASE_URL=
AI_REMOTION_TTS_TIMEOUT_MS=300000

AI_REMOTION_AVATAR_PROVIDER=latentsync
AI_REMOTION_AVATAR_BASE_URL=
AI_REMOTION_AVATAR_TIMEOUT_MS=900000

AI_REMOTION_ARK_API_KEY=
AI_REMOTION_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_REMOTION_ARK_MODEL=
AI_REMOTION_SEEDANCE_AVATAR_ASSET_ID=

AI_REMOTION_TOS_ACCESS_KEY_ID=
AI_REMOTION_TOS_ACCESS_KEY_SECRET=
AI_REMOTION_TOS_BUCKET=
AI_REMOTION_TOS_ENDPOINT=
AI_REMOTION_TOS_REGION=
AI_REMOTION_TOS_PREFIX=ai-remotion

HEYGEN_API_KEY=

AI_REMOTION_DREAMINA_BIN=dreamina

AI_REMOTION_DOUYIN_CLIENT_KEY=
AI_REMOTION_DOUYIN_CLIENT_SECRET=
AI_REMOTION_DOUYIN_ACCESS_TOKEN=
AI_REMOTION_DOUYIN_OPEN_ID=
AI_REMOTION_DOUYIN_REFRESH_TOKEN=

FLAG_voice_clone={"enabled":false}
FLAG_talking_avatar={"enabled":false}
FLAG_seedance_presenter={"enabled":false}
FLAG_latentsync_lipsync={"enabled":false}
FLAG_dreamina_media={"enabled":false}
FLAG_video_hotspot={"enabled":false}
FLAG_video_hotspot_crawler={"enabled":false}
FLAG_video_publish={"enabled":false}
FLAG_video_publish_douyin={"enabled":false}
FLAG_video_publish_weixin_channels={"enabled":false}
FLAG_video_publish_xiaohongshu={"enabled":false}
