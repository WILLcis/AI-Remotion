<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-remotion.hotspot-crawler</string>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/AI-Remotion</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>run</string>
    <string>hotspot:watch</string>
    <string>--</string>
    <string>--format</string>
    <string>human-vo</string>
    <string>--topic</string>
    <string>数字货币</string>
    <string>--repeat</string>
    <string>daily</string>
    <string>--daily-time</string>
    <string>08:00</string>
    <string>--pack-only</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/AI-Remotion/state/hotspot/crawler.out.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/AI-Remotion/state/hotspot/crawler.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FLAG_video_hotspot</key>
    <string>{"enabled":true}</string>
    <key>FLAG_video_hotspot_crawler</key>
    <string>{"enabled":true}</string>
  </dict>
</dict>
</plist>
